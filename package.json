{
  "name": "global-macro-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Calm, low-frequency global macro dashboard. Data refreshed by GitHub Actions, stored in this repo, served by GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-data.ts && vite",
    "data": "node scripts/build-data.ts",
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build-data.ts && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "refresh": "node --env-file-if-exists=.env pipeline/run.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.6.1"
  },
  "license": "MIT"
}
